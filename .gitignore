# Datasets and large binaries are not source.
# Anchored to the repo root on purpose: an unanchored 'data/' also matches
# src/medus_class/data/ and configs/data/, which silently left the CIFAR-10
# loader and the class-split module untracked.
/data/
*.pt
__pycache__/
*.py[cod]
.venv/
.pytest_cache/

# Run outputs. The configs and code that produce them are tracked; the
# artefacts are not, with the exception of the small analysis summaries below.
results/*.out
results/*.err
results/*_log.csv
results/*_environment.json

# Contents ignored, NOT the directories themselves. Git cannot re-include a
# file whose parent directory is excluded, and the four checkpoints below have
# to be re-includable -- see docs/artifact_manifest.md.
results/checkpoints/*
results/search/*

# Downloaded Kaggle output bundles. 83 MB each, and there will be one per
# class -- the checkpoints inside them are imported into results/ and the
# metadata that survives is committed separately. The zip itself is a
# transport artefact, and it is NOT ignored by any other rule, so without
# this line a plain 'git add -A' would stage it.
reference_outputs_*.zip

# Kaggle reference-training scratch. The staging directory is where finished
# checkpoints are collected before zipping; the zip is the artefact, and the
# checkpoints inside it are 85 MB each. The validation summary beside it IS
# tracked.
results/reference_training/staging/

# Kept: the class-structure measurement that motivates the whole project.
!results/analysis/
!results/analysis/**
!results/splits/
!results/splits/**

# --- ship (class 8) Plan A run --------------------------------------------
# Same treatment the frog run's tracked files get: the small summaries, fronts,
# figure and reports are the result and belong in git. evaluation_history.csv is
# every evaluation including failures -- useful for post-hoc analysis, too noisy
# to track -- and no *.pt is produced by a search anyway.
!results/search/plan_a_ship/
!results/search/plan_a_ship/**
results/search/plan_a_ship/evaluation_history.csv

# --- the remaining seven Plan A runs ---------------------------------------
# Same treatment as frog, ship and airplane: summaries, fronts, figures and
# reports tracked; evaluation_history.csv (every evaluation including
# failures) left out.

!results/search/plan_a_automobile/
!results/search/plan_a_automobile/**
results/search/plan_a_automobile/evaluation_history.csv
!results/search/plan_a_bird/
!results/search/plan_a_bird/**
results/search/plan_a_bird/evaluation_history.csv
!results/search/plan_a_cat/
!results/search/plan_a_cat/**
results/search/plan_a_cat/evaluation_history.csv
!results/search/plan_a_deer/
!results/search/plan_a_deer/**
results/search/plan_a_deer/evaluation_history.csv
!results/search/plan_a_dog/
!results/search/plan_a_dog/**
results/search/plan_a_dog/evaluation_history.csv
!results/search/plan_a_horse/
!results/search/plan_a_horse/**
results/search/plan_a_horse/evaluation_history.csv
!results/search/plan_a_truck/
!results/search/plan_a_truck/**
results/search/plan_a_truck/evaluation_history.csv

# --- airplane (class 0) Plan A run -----------------------------------------
# Same treatment as the frog and ship runs: small summaries, fronts, figure and
# reports are tracked; evaluation_history.csv is every evaluation including
# failures, too noisy to carry.
!results/search/plan_a_airplane/
!results/search/plan_a_airplane/**
results/search/plan_a_airplane/evaluation_history.csv

# --- BN-frozen refinements, the remaining classes --------------------------
# Same treatment as ship's: the refinement record and report are the result
# and belong in git; the refined checkpoint does not -- 43 MB each, and LFS
# is still approved only for the frog chain. The JSON records every metric
# needed to recognise the model.

!results/search/plan_a_automobile_bn_frozen_refined/
!results/search/plan_a_automobile_bn_frozen_refined/**
results/search/plan_a_automobile_bn_frozen_refined/*.pt
!results/search/plan_a_bird_bn_frozen_refined/
!results/search/plan_a_bird_bn_frozen_refined/**
results/search/plan_a_bird_bn_frozen_refined/*.pt
!results/search/plan_a_cat_bn_frozen_refined/
!results/search/plan_a_cat_bn_frozen_refined/**
results/search/plan_a_cat_bn_frozen_refined/*.pt
!results/search/plan_a_deer_bn_frozen_refined/
!results/search/plan_a_deer_bn_frozen_refined/**
results/search/plan_a_deer_bn_frozen_refined/*.pt
!results/search/plan_a_dog_bn_frozen_refined/
!results/search/plan_a_dog_bn_frozen_refined/**
results/search/plan_a_dog_bn_frozen_refined/*.pt
!results/search/plan_a_horse_bn_frozen_refined/
!results/search/plan_a_horse_bn_frozen_refined/**
results/search/plan_a_horse_bn_frozen_refined/*.pt
!results/search/plan_a_truck_bn_frozen_refined/
!results/search/plan_a_truck_bn_frozen_refined/**
results/search/plan_a_truck_bn_frozen_refined/*.pt

# --- ship BN-frozen refinement --------------------------------------------
# The refinement record and report are the result and belong in git. The
# refined checkpoint itself does NOT: it is 43 MB, LFS is not approved for
# anything beyond the frog chain, and the JSON records the sha and every metric
# needed to recognise it.
!results/search/plan_a_ship_bn_frozen_refined/
!results/search/plan_a_ship_bn_frozen_refined/**
results/search/plan_a_ship_bn_frozen_refined/*.pt

# --- checkpoints that ARE part of the published result ---------------------
# Stored through Git LFS (see .gitattributes). These four are the whole
# reproducible chain: the model unlearned FROM, the reference f1 is measured
# against, and the two results. The *_final / *_latest reference checkpoints and
# the dist/ copy of W_0 are training bookkeeping and duplicates -- they stay
# external, because LFS quota is finite and nothing reads them.
!results/checkpoints/cifar10_resnet18_seed42_best.pt
!results/checkpoints/class6_frog_reference_best_dr.pt
!results/checkpoints/class6_frog_C_star_pure_gradient_free.pt
!results/search/plan_a_frog_bn_frozen_refined/
!results/search/plan_a_frog_bn_frozen_refined/refined_best.pt

# Their provenance sidecars are plain JSON and belong in git normally.
!results/checkpoints/cifar10_resnet18_seed42_best.json
!results/checkpoints/class6_frog_reference_best_dr.json
!results/checkpoints/class6_frog_C_star_pure_gradient_free.json

dist/
