diff --git a/src/medus/data/datasets.py b/src/medus/data/datasets.py
index a5c2e07..dfbe8d8 100644
--- a/src/medus/data/datasets.py
+++ b/src/medus/data/datasets.py
@@ -290,3 +290,70 @@ def _fixed_subset(
     if size >= indices.size:
         return indices
     return np.sort(rng.choice(indices, size, replace=False))
+
+
+@dataclass
+class ClassTestLoaders:
+    """Held-out test data split by the forget class.
+
+    ``forget_test``   ``D_f_test`` -- test samples of the forgotten class
+    ``retain_test``   ``D_r_test`` -- test samples of the other nine classes
+
+    The instance-level pipeline has no equivalent: there, ``D_f`` and ``D_T``
+    are the same ten classes and one ``test_eval`` loader covers utility. Class
+    unlearning is judged on whether the model still recognises *unseen* members
+    of the forgotten class, which needs the two measured apart.
+    """
+
+    forget_test: DataLoader
+    retain_test: DataLoader
+    forget_class: int
+
+    def sizes(self) -> dict[str, int]:
+        return {
+            "forget_test": len(self.forget_test.dataset),
+            "retain_test": len(self.retain_test.dataset),
+        }
+
+
+def build_class_test_loaders(
+    bundle: CIFAR10Bundle,
+    forget_class: int,
+    data_cfg: dict[str, Any],
+    seed: int = 42,
+    subset_size: int | None = None,
+) -> ClassTestLoaders:
+    """Build the ``D_f_test`` / ``D_r_test`` loaders for a class-unlearning run.
+
+    Deliberately separate from :func:`build_unlearning_loaders` rather than
+    folded into it. That function is what every search so far was measured
+    through; widening its signature would put the whole instance-level record at
+    risk of a silent behaviour change for no benefit, since these two loaders
+    are only ever needed by the class-unlearning evaluation.
+
+    Parameters
+    ----------
+    subset_size:
+        If given, each loader is restricted to a fixed seeded subset of this
+        many samples. ``D_f_test`` holds only 1 000 CIFAR-10 images, so leave
+        this ``None`` for any reported number -- it exists for smoke tests.
+    """
+    from medus.data.splits import class_test_partition
+
+    eval_bs = int(data_cfg["batch_size"]["eval"])
+    forget_idx, retain_idx = class_test_partition(bundle.test.targets, forget_class)
+
+    if subset_size is not None:
+        rng = np.random.RandomState(seed)
+        forget_idx = _fixed_subset(forget_idx, subset_size, rng)
+        retain_idx = _fixed_subset(retain_idx, subset_size, rng)
+
+    return ClassTestLoaders(
+        forget_test=make_loader(
+            Subset(bundle.test, forget_idx.tolist()), eval_bs, False, data_cfg, seed
+        ),
+        retain_test=make_loader(
+            Subset(bundle.test, retain_idx.tolist()), eval_bs, False, data_cfg, seed
+        ),
+        forget_class=int(forget_class),
+    )
diff --git a/src/medus/data/splits.py b/src/medus/data/splits.py
index caa6d1c..fbae2a2 100644
--- a/src/medus/data/splits.py
+++ b/src/medus/data/splits.py
@@ -267,3 +267,190 @@ def get_or_create_split(
     split = create_split(dataset_size, forget_fraction, seed)
     save_split(split, csv_path)
     return split, True
+
+
+# ---------------------------------------------------------------------------
+# Class-level splits
+# ---------------------------------------------------------------------------
+#
+# The instance-level split above is the project's primary setting. The
+# class-level split below exists for one purpose: the diagnostic contrast that
+# tests why instance-level selectivity hit a ceiling at S ~ 1.16.
+#
+# The explanation on record is that D_f and D_r are the same ten CIFAR-10
+# classes, so the network uses the same channels for both and no weight edit can
+# be selective. That predicts that making D_f a whole class -- genuinely
+# different data -- should produce forget-specific structure. These functions
+# build that split.
+#
+# The output format is deliberately identical to the instance-level one: a
+# single-column ``unlearn_idx`` CSV plus a JSON sidecar. Everything downstream
+# (``train_original.py --split``, ``build_unlearning_loaders``) consumes forget
+# indices without caring how they were chosen, so a class split needs no changes
+# there.
+
+#: CIFAR-10 label order, as shipped by torchvision. Index == integer label.
+CIFAR10_CLASS_NAMES: tuple[str, ...] = (
+    "airplane", "automobile", "bird", "cat", "deer",
+    "dog", "frog", "horse", "ship", "truck",
+)
+
+
+def create_class_split(
+    labels: np.ndarray | list[int],
+    forget_class: int,
+) -> UnlearningSplit:
+    """Build a forget/retain partition where ``D_f`` is one entire class.
+
+    Parameters
+    ----------
+    labels:
+        Integer label per training sample, in dataset index order. For CIFAR-10
+        this is ``bundle.train_clean.targets``.
+    forget_class:
+        The class to forget. Every training sample carrying this label goes to
+        ``D_f``; everything else goes to ``D_r``.
+
+    Notes
+    -----
+    Unlike the instance-level split there is no randomness and no seed: the
+    class label fully determines the partition. ``seed`` is recorded as ``-1``
+    and ``forget_fraction`` as the fraction the class happens to occupy (0.1 for
+    a balanced CIFAR-10 class), purely so the resulting ``UnlearningSplit``
+    carries the same metadata as every other split in the project.
+    """
+    label_array = np.asarray(labels, dtype=np.int64)
+    dataset_size = int(label_array.size)
+
+    if not 0 <= forget_class < 10:
+        raise ValueError(f"forget_class must be a CIFAR-10 label 0-9, got {forget_class}")
+
+    forget_indices = np.sort(np.flatnonzero(label_array == forget_class))
+    if forget_indices.size == 0:
+        raise ValueError(
+            f"class {forget_class} has no training samples; "
+            f"labels present: {sorted(set(label_array.tolist()))}"
+        )
+    if forget_indices.size == dataset_size:
+        raise ValueError(
+            f"class {forget_class} covers the whole training set, leaving D_r empty"
+        )
+
+    retain_indices = np.setdiff1d(np.arange(dataset_size), forget_indices)
+
+    return UnlearningSplit(
+        forget_indices=forget_indices,
+        retain_indices=retain_indices,
+        dataset_size=dataset_size,
+        forget_fraction=forget_indices.size / dataset_size,
+        seed=-1,
+    )
+
+
+def save_class_split(
+    split: UnlearningSplit,
+    forget_class: int,
+    path: str | Path,
+) -> Path:
+    """Write a class split in the same format as an instance split.
+
+    The sidecar gains ``strategy``, ``forget_class`` and ``forget_class_name``
+    so a split file on disk can never be mistaken for an instance-level one --
+    the two are the same size for CIFAR-10 (5 000 indices) and would otherwise
+    be indistinguishable.
+    """
+    csv_path = resolve_path(path)
+    csv_path.parent.mkdir(parents=True, exist_ok=True)
+
+    pd.DataFrame({AMUN_INDEX_COLUMN: split.forget_indices}).to_csv(csv_path, index=False)
+
+    summary = split.summary()
+    summary["strategy"] = "forget_class"
+    summary["forget_class"] = int(forget_class)
+    summary["forget_class_name"] = CIFAR10_CLASS_NAMES[forget_class]
+
+    meta_path = csv_path.with_suffix(".json")
+    meta_path.write_text(json.dumps(summary, indent=2), encoding="utf-8")
+    return csv_path
+
+
+def get_or_create_class_split(
+    labels: np.ndarray | list[int],
+    forget_class: int,
+    path: str | Path,
+    overwrite: bool = False,
+) -> tuple[UnlearningSplit, bool]:
+    """Load the class split at ``path``, creating and saving it if absent.
+
+    A pre-existing file recorded against a *different* forget class is a silent
+    experiment-configuration error -- the run would unlearn one class while
+    reporting another -- so it raises rather than proceeding.
+
+    Returns
+    -------
+    tuple
+        ``(split, created)``.
+    """
+    csv_path = resolve_path(path)
+    label_array = np.asarray(labels, dtype=np.int64)
+
+    if csv_path.is_file() and not overwrite:
+        split = load_split(csv_path, int(label_array.size))
+
+        meta_path = csv_path.with_suffix(".json")
+        if meta_path.is_file():
+            meta = json.loads(meta_path.read_text(encoding="utf-8"))
+            recorded = meta.get("forget_class")
+            if recorded is not None and int(recorded) != int(forget_class):
+                raise ValueError(
+                    f"existing split {csv_path} was built for class {recorded} "
+                    f"({meta.get('forget_class_name')}) but the config requests "
+                    f"class {forget_class} ({CIFAR10_CLASS_NAMES[forget_class]}). "
+                    f"Refusing to continue; delete the file or fix the config."
+                )
+
+        # Independent of the sidecar: verify the indices really are that class.
+        actual = np.unique(label_array[split.forget_indices])
+        if actual.size != 1 or int(actual[0]) != int(forget_class):
+            raise ValueError(
+                f"existing split {csv_path} does not hold exactly class "
+                f"{forget_class}: its forget indices cover labels "
+                f"{actual.tolist()}"
+            )
+        return split, False
+
+    split = create_class_split(label_array, forget_class)
+    save_class_split(split, forget_class, csv_path)
+    return split, True
+
+
+def class_test_partition(
+    test_labels: np.ndarray | list[int],
+    forget_class: int,
+) -> tuple[np.ndarray, np.ndarray]:
+    """Partition the test set into ``D_f_test`` and ``D_r_test``.
+
+    Class unlearning is judged on held-out data of the forgotten class, which
+    the instance-level pipeline never needed: there, ``D_f`` and the test set
+    are the same ten classes, so a single ``test_eval`` loader covered utility.
+    Here the forget class must be measured separately or the headline number
+    (does the model still recognise airplanes it has never seen?) cannot be
+    computed at all.
+
+    Returns
+    -------
+    tuple
+        ``(forget_test_indices, retain_test_indices)``, both sorted.
+    """
+    label_array = np.asarray(test_labels, dtype=np.int64)
+
+    if not 0 <= forget_class < 10:
+        raise ValueError(f"forget_class must be a CIFAR-10 label 0-9, got {forget_class}")
+
+    forget_test = np.sort(np.flatnonzero(label_array == forget_class))
+    retain_test = np.setdiff1d(np.arange(label_array.size), forget_test)
+
+    if forget_test.size == 0:
+        raise ValueError(f"class {forget_class} has no test samples")
+
+    return forget_test, retain_test
